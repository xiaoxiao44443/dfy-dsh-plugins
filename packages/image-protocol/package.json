{
  "name": "@dfy-plugins/image-protocol",
  "version": "0.1.1",
  "description": "Shared image attachment references, validation and result projection for DFY DSH plugins.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./session-storage": {
      "types": "./lib/session-storage.d.ts",
      "default": "./lib/session-storage.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test"
  },
  "dependencies": {
    "@dfy-plugins/resource-core": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2 || ^0.1.2-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2 || ^0.1.2-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-attachment": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0"
  }
}
