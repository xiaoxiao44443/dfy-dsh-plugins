{
  "name": "@dfy-plugins/dsh-archive-manager",
  "version": "0.1.4",
  "description": "归档对话管理：按项目查看、取消归档或永久删除已归档的对话。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "tsc -p tsconfig.json && node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-alpha.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoxiao44443/dfy-dsh-plugins.git",
    "directory": "plugins/archive-manager"
  },
  "homepage": "https://github.com/xiaoxiao44443/dfy-dsh-plugins#readme",
  "bugs": {
    "url": "https://github.com/xiaoxiao44443/dfy-dsh-plugins/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin"
  ]
}
