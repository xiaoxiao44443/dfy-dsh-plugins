{
  "name": "@dfy-plugins/dsh-appearance",
  "version": "0.1.6",
  "description": "DFY DSH 对话外观设置：调节聊天字号、回复行距与过程行距，并扩展本地文件的打开方式。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "tsc -p tsconfig.json && node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-settings": ">=0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.3",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.3",
    "@types/react": "~18.3.1",
    "esbuild": "^0.24.0",
    "react": "^18.2.0",
    "typescript": "^6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoxiao44443/dfy-dsh-plugins.git",
    "directory": "plugins/appearance"
  },
  "homepage": "https://github.com/xiaoxiao44443/dfy-dsh-plugins#readme",
  "bugs": {
    "url": "https://github.com/xiaoxiao44443/dfy-dsh-plugins/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin"
  ],
  "dependencies": {
    "@dfy-plugins/resource-core": "workspace:^"
  }
}
