{
  "name": "@dfy-plugins/dsh-codex-bridge",
  "version": "0.1.3",
  "description": "让 Codex 通过本机 MCP 使用 DeepSeek Harness 的活动会话、工具和 Skills。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "codex-marketplace",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "tsc -p tsconfig.json && node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-agent": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-settings": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-skill": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-tools": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-workspace": ">=0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.3",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.1.7-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-agent": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-skill": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-workspace": "0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.3",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.24.0",
    "react": "^18.2.0",
    "typescript": "^6.0.3",
    "@deepseek-ai/dsh-agent-preset-registry": "0.1.7-alpha.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoxiao44443/dfy-dsh-plugins.git",
    "directory": "plugins/codex-bridge"
  },
  "homepage": "https://github.com/xiaoxiao44443/dfy-dsh-plugins#readme",
  "bugs": {
    "url": "https://github.com/xiaoxiao44443/dfy-dsh-plugins/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin"
  ],
  "dependencies": {
    "@dfy-plugins/resource-core": "workspace:^"
  }
}
