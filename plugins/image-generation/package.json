{
  "name": "@dfy-plugins/dsh-image-generation",
  "version": "0.1.4",
  "description": "为 DeepSeek Harness 提供独立的图像生成与编辑 Skill、工具和设置界面。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "dependencies": {
    "@dfy-plugins/image-protocol": "workspace:^",
    "@dfy-plugins/resource-core": "workspace:^"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "test": "tsc -p tsconfig.json && node --test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-attachment": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-credentials": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-fs": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-settings": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-skill": ">=0.1.7-alpha.1",
    "@deepseek-ai/dsh-tools": ">=0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.3",
    "@dfy-plugins/dsh-media-blocks": "^0.1.4",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@dfy-plugins/dsh-media-blocks": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-attachment": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-credentials": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-fs": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-skill": "0.1.7-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.3",
    "@dfy-plugins/dsh-media-blocks": "workspace:^",
    "@dfy-plugins/image-protocol": "workspace:^",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.24.0",
    "react": "^18.2.0",
    "react-dom": "18.3.1",
    "typescript": "^6.0.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoxiao44443/dfy-dsh-plugins.git",
    "directory": "plugins/image-generation"
  },
  "homepage": "https://github.com/xiaoxiao44443/dfy-dsh-plugins#readme",
  "bugs": {
    "url": "https://github.com/xiaoxiao44443/dfy-dsh-plugins/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin"
  ]
}
